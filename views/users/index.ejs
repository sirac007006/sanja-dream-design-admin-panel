<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Korisnici - Sanja Dream Design Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="admin-container">
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo"><i class="fas fa-gem"></i></div>
                <div><div class="sidebar-title">Sanja Dream</div><div class="sidebar-subtitle">Admin Panel</div></div>
            </div>
            <nav class="nav-section">
                <div class="nav-section-title">Glavno</div>
                <a href="/dashboard" class="nav-link"><i class="fas fa-home"></i> Dashboard</a>
            </nav>
            <nav class="nav-section">
                <div class="nav-section-title">E-commerce</div>
                <a href="/products" class="nav-link"><i class="fas fa-box"></i> Proizvodi</a>
                <a href="/categories" class="nav-link"><i class="fas fa-tags"></i> Kategorije</a>
                <a href="/subcategories" class="nav-link"><i class="fas fa-tag"></i> Podkategorije</a>
                <a href="/orders" class="nav-link"><i class="fas fa-shopping-bag"></i> Porudžbine</a>
            </nav>
            <nav class="nav-section">
                <div class="nav-section-title">Korisnici</div>
                <a href="/users" class="nav-link active"><i class="fas fa-users"></i> Korisnici</a>
                <a href="/loyalty" class="nav-link"><i class="fas fa-star"></i> Loyalty Poeni</a>
            </nav>
            <nav class="nav-section" style="margin-top: auto; padding-top: 20px; border-top: 1px solid var(--border-color);">
                <a href="/logout" class="nav-link" style="color: var(--danger);"><i class="fas fa-sign-out-alt"></i> Odjavi se</a>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Korisnici</h1>
                    <p class="page-subtitle">Upravljanje korisnicima - Ukupno: <%= users.length %></p>
                </div>
                <button class="btn btn-primary" onclick="openModal('addUserModal')"><i class="fas fa-plus"></i> Dodaj korisnika</button>
            </div>

            <div class="filters-bar">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Pretraži korisnike..." id="searchInput">
                </div>
            </div>

            <div class="card">
                <div class="card-body" style="padding: 0;">
                    <table class="table" id="dataTable">
                        <thead>
                            <tr><th>ID</th><th>Korisnik</th><th>Email</th><th>Telefon</th><th>Uloga</th><th>Poeni</th><th>Registrovan</th><th>Akcije</th></tr>
                        </thead>
                        <tbody>
                            <% users.forEach(function(user) { %>
                            <tr>
                                <td><strong>#<%= user.user_id %></strong></td>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar"><%= user.first_name ? user.first_name[0].toUpperCase() : 'U' %></div>
                                        <span class="user-name"><%= user.first_name %> <%= user.last_name %></span>
                                    </div>
                                </td>
                                <td><%= user.email %></td>
                                <td><%= user.phone || '-' %></td>
                                <td><span class="badge <%= user.role === 'admin' ? 'badge-purple' : 'badge-info' %>"><%= user.role === 'admin' ? 'Admin' : 'Kupac' %></span></td>
                                <td><span class="points-value"><%= user.loyalty_points || 0 %></span></td>
                                <td><%= new Date(user.created_at).toLocaleDateString('sr-RS') %></td>
                                <td>
                                    <div class="table-actions">
                                        <a href="/users/<%= user.user_id %>" class="btn btn-sm btn-secondary btn-icon"><i class="fas fa-eye"></i></a>
                                        <button class="btn btn-sm btn-danger btn-icon" onclick="deleteUser(<%= user.user_id %>)"><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Add User Modal -->
    <div class="modal-overlay" id="addUserModal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Dodaj novog korisnika</h3>
                <button class="modal-close" onclick="closeModal('addUserModal')"><i class="fas fa-times"></i></button>
            </div>
            <form id="addUserForm">
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Ime</label>
                            <input type="text" name="first_name" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Prezime</label>
                            <input type="text" name="last_name" class="form-input" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-input" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Lozinka</label>
                        <input type="password" name="password" class="form-input" required minlength="6">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Telefon</label>
                            <input type="text" name="phone" class="form-input">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Uloga</label>
                            <select name="role" class="form-select">
                                <option value="customer">Kupac</option>
                                <option value="admin">Administrator</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('addUserModal')">Otkaži</button>
                    <button type="submit" class="btn btn-primary">Sačuvaj</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/main.js"></script>
    <script>
        document.getElementById('addUserForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            
            try {
                const response = await fetch('/api/users', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (response.ok) {
                    showToast('Korisnik uspješno dodat!');
                    setTimeout(function() { location.reload(); }, 1000);
                } else {
                    showToast(result.error || 'Greška!', 'error');
                }
            } catch (err) {
                showToast('Greška!', 'error');
            }
        });

        async function deleteUser(id) {
            if (!confirm('Da li ste sigurni?')) return;
            try {
                const response = await fetch('/api/users/' + id, { method: 'DELETE' });
                if (response.ok) {
                    showToast('Korisnik obrisan!');
                    setTimeout(function() { location.reload(); }, 1000);
                }
            } catch (err) {
                showToast('Greška!', 'error');
            }
        }
    </script>
</body>
</html>
