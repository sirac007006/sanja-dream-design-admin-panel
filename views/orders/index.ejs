<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Porudžbine - Sanja Dream Design Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="admin-container">
        <aside class="sidebar">
            <div class="sidebar-header"><div class="sidebar-logo"><i class="fas fa-gem"></i></div><div><div class="sidebar-title">Sanja Dream</div><div class="sidebar-subtitle">Admin Panel</div></div></div>
            <nav class="nav-section"><div class="nav-section-title">Glavno</div><a href="/dashboard" class="nav-link"><i class="fas fa-home"></i> Dashboard</a></nav>
            <nav class="nav-section"><div class="nav-section-title">E-commerce</div><a href="/products" class="nav-link"><i class="fas fa-box"></i> Proizvodi</a><a href="/categories" class="nav-link"><i class="fas fa-tags"></i> Kategorije</a><a href="/subcategories" class="nav-link"><i class="fas fa-tag"></i> Podkategorije</a><a href="/orders" class="nav-link active"><i class="fas fa-shopping-bag"></i> Porudžbine</a></nav>
            <nav class="nav-section"><div class="nav-section-title">Korisnici</div><a href="/users" class="nav-link"><i class="fas fa-users"></i> Korisnici</a><a href="/loyalty" class="nav-link"><i class="fas fa-star"></i> Loyalty Poeni</a></nav>
            <nav class="nav-section" style="margin-top: auto; padding-top: 20px; border-top: 1px solid var(--border-color);"><a href="/logout" class="nav-link" style="color: var(--danger);"><i class="fas fa-sign-out-alt"></i> Odjavi se</a></nav>
        </aside>
        <main class="main-content">
            <div class="page-header">
                <div><h1 class="page-title">Porudžbine</h1><p class="page-subtitle">Ukupno: <%= orders.length %></p></div>
            </div>
            <div class="filters-bar"><div class="search-box"><i class="fas fa-search"></i><input type="text" placeholder="Pretraži..." id="searchInput"></div></div>
            <div class="card"><div class="card-body" style="padding: 0;">
                <table class="table" id="dataTable">
                    <thead><tr><th>ID</th><th>Korisnik</th><th>Iznos</th><th>Status</th><th>Plaćanje</th><th>Datum</th><th>Akcije</th></tr></thead>
                    <tbody>
                        <% orders.forEach(function(o) { %>
                        <tr>
                            <td><strong>#<%= o.order_id %></strong></td>
                            <td>
                                <div class="user-info">
                                    <div class="user-avatar"><%= o.first_name ? o.first_name[0].toUpperCase() : 'U' %></div>
                                    <div><div class="user-name"><%= o.first_name || 'N/A' %> <%= o.last_name || '' %></div><div class="user-email"><%= o.email || '' %></div></div>
                                </div>
                            </td>
                            <td><strong style="color: var(--success);"><%= parseFloat(o.total_amount || 0).toFixed(2) %> €</strong></td>
                            <td><span class="badge badge-<%= o.status === 'delivered' ? 'success' : o.status === 'cancelled' ? 'danger' : o.status === 'shipped' ? 'info' : 'warning' %>"><%= o.status || 'pending' %></span></td>
                            <td><%= o.payment_method || '-' %></td>
                            <td><%= new Date(o.created_at).toLocaleDateString('sr-RS') %></td>
                            <td>
                                <div class="table-actions">
                                    <a href="/orders/<%= o.order_id %>" class="btn btn-sm btn-secondary btn-icon"><i class="fas fa-eye"></i></a>
                                    <button class="btn btn-sm btn-primary btn-icon" onclick="editStatus(<%= o.order_id %>, '<%= o.status || 'pending' %>')"><i class="fas fa-edit"></i></button>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div></div>
        </main>
    </div>

    <div class="modal-overlay" id="editModal">
        <div class="modal" style="max-width: 400px;">
            <div class="modal-header"><h3 class="modal-title">Izmjeni status porudžbine</h3><button class="modal-close" onclick="closeModal('editModal')"><i class="fas fa-times"></i></button></div>
            <form id="editForm">
                <input type="hidden" name="id" id="edit_id">
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label">Status</label>
                        <select name="status" id="edit_status" class="form-select">
                            <option value="pending">Na čekanju</option>
                            <option value="processing">U obradi</option>
                            <option value="shipped">Poslato</option>
                            <option value="delivered">Dostavljeno</option>
                            <option value="cancelled">Otkazano</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">Otkaži</button><button type="submit" class="btn btn-primary">Sačuvaj</button></div>
            </form>
        </div>
    </div>

    <script src="/js/main.js"></script>
    <script>
        function editStatus(id, status) {
            document.getElementById('edit_id').value = id;
            document.getElementById('edit_status').value = status;
            openModal('editModal');
        }

        document.getElementById('editForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('edit_id').value;
            const status = document.getElementById('edit_status').value;
            try {
                const res = await fetch('/api/orders/' + id + '/status', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) });
                if (res.ok) { showToast('Status ažuriran!'); setTimeout(function(){location.reload();}, 1000); } else { showToast('Greška!', 'error'); }
            } catch(e) { showToast('Greška!', 'error'); }
        });
    </script>
</body>
</html>
