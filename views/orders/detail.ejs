<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Porudžbina #<%= order.order_id %> - Sanja Dream Design Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="admin-container">
        <aside class="sidebar">
            <div class="sidebar-header"><div class="sidebar-logo"><i class="fas fa-gem"></i></div><div><div class="sidebar-title">Sanja Dream</div><div class="sidebar-subtitle">Admin Panel</div></div></div>
            <nav class="nav-section"><div class="nav-section-title">Glavno</div><a href="/dashboard" class="nav-link"><i class="fas fa-home"></i> Dashboard</a></nav>
            <nav class="nav-section"><div class="nav-section-title">E-commerce</div><a href="/products" class="nav-link"><i class="fas fa-box"></i> Proizvodi</a><a href="/categories" class="nav-link"><i class="fas fa-tags"></i> Kategorije</a><a href="/subcategories" class="nav-link"><i class="fas fa-tag"></i> Podkategorije</a><a href="/orders" class="nav-link active"><i class="fas fa-shopping-bag"></i> Porudžbine</a></nav>
            <nav class="nav-section"><div class="nav-section-title">Korisnici</div><a href="/users" class="nav-link"><i class="fas fa-users"></i> Korisnici</a><a href="/loyalty" class="nav-link"><i class="fas fa-star"></i> Loyalty Poeni</a></nav>
            <nav class="nav-section" style="margin-top: auto; padding-top: 20px; border-top: 1px solid var(--border-color);"><a href="/logout" class="nav-link" style="color: var(--danger);"><i class="fas fa-sign-out-alt"></i> Odjavi se</a></nav>
        </aside>
        <main class="main-content">
            <div class="page-header">
                <div><h1 class="page-title">Porudžbina #<%= order.order_id %></h1><p class="page-subtitle"><%= new Date(order.created_at).toLocaleDateString('sr-RS', {day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit'}) %></p></div>
                <a href="/orders" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Nazad</a>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Detalji porudžbine</h3><span class="badge badge-<%= order.status === 'delivered' ? 'success' : order.status === 'cancelled' ? 'danger' : 'warning' %>"><%= order.status || 'pending' %></span></div>
                    <div class="card-body">
                        <div class="detail-grid">
                            <div class="detail-item"><div class="detail-label">Ukupan iznos</div><div class="detail-value" style="color: var(--success); font-size: 24px;"><%= parseFloat(order.total_amount || 0).toFixed(2) %> €</div></div>
                            <div class="detail-item"><div class="detail-label">Dostava</div><div class="detail-value"><%= parseFloat(order.shipping_cost || 0).toFixed(2) %> €</div></div>
                            <div class="detail-item"><div class="detail-label">Način plaćanja</div><div class="detail-value"><%= order.payment_method || '-' %></div></div>
                            <div class="detail-item"><div class="detail-label">Iskorišteni poeni</div><div class="detail-value"><%= order.points_used || 0 %></div></div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Kupac</h3></div>
                    <div class="card-body">
                        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 20px;">
                            <div class="user-avatar" style="width: 56px; height: 56px; font-size: 22px;"><%= order.first_name ? order.first_name[0].toUpperCase() : 'U' %></div>
                            <div><h3><%= order.first_name || 'N/A' %> <%= order.last_name || '' %></h3><p style="color: var(--text-muted);"><%= order.email || '-' %></p></div>
                        </div>
                        <div class="detail-grid">
                            <div class="detail-item"><div class="detail-label">Telefon</div><div class="detail-value"><%= order.phone || '-' %></div></div>
                            <div class="detail-item"><div class="detail-label">Grad</div><div class="detail-value"><%= order.city || '-' %></div></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card" style="margin-top: 24px;">
                <div class="card-header"><h3 class="card-title">Stavke</h3></div>
                <div class="card-body" style="padding: 0;">
                    <table class="table">
                        <thead><tr><th>Proizvod</th><th>Količina</th><th>Cijena</th><th>Ukupno</th></tr></thead>
                        <tbody>
                            <% items.forEach(function(item) { %>
                            <tr>
                                <td><strong><%= item.product_name %></strong></td>
                                <td><span class="badge badge-info"><%= item.quantity %></span></td>
                                <td><%= parseFloat(item.price).toFixed(2) %> €</td>
                                <td><strong><%= (parseFloat(item.price) * item.quantity).toFixed(2) %> €</strong></td>
                            </tr>
                            <% }); %>
                            <% if (items.length === 0) { %>
                            <tr><td colspan="4" style="text-align: center; padding: 30px;">Nema stavki</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
    <script src="/js/main.js"></script>
</body>
</html>
