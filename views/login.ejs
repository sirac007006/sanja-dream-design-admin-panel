<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Sanja Dream Design Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="login-container">
        <div class="login-box">
            <div class="login-logo">
                <i class="fas fa-gem"></i>
            </div>
            <h1 class="login-title">Sanja Dream Design</h1>
            <p class="login-subtitle">Admin Panel - Prijava</p>
            
            <% if (error) { %>
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> <%= error %>
                </div>
            <% } %>
            
            <form action="/login" method="POST">
                <div class="form-group">
                    <label class="form-label">Korisničko ime</label>
                    <input type="text" name="username" class="form-input" placeholder="Unesite korisničko ime" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Lozinka</label>
                    <input type="password" name="password" class="form-input" placeholder="Unesite lozinku" required>
                </div>
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-sign-in-alt"></i> Prijavi se
                </button>
            </form>
        </div>
    </div>
</body>
</html>
